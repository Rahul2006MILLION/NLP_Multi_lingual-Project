{
  "name": "cross-lingual-calibration",
  "private": true,
  "version": "1.0.0",
  "description": "React + FastAPI interface for the cross-lingual calibration research platform",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "python3 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend",
    "build": "npm --prefix frontend run build",
    "test:api": "python3 -m pytest backend/tests -q",
    "postinstall": "npm --prefix frontend install"
  }
}
